[global]
frame_color = "#89B4FA"
separator_color= frame

[urgency_low]
background = "#1E1E2E"
foreground = "#CDD6F4"
timeout = 5

[urgency_normal]
background = "#1E1E2E"
foreground = "#CDD6F4"
timeout = 10

[urgency_critical]
background = "#1E1E2E"
foreground = "#CDD6F4"
frame_color = "#FAB387"
timeout = 10

